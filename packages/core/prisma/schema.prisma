generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "sqlite"
}

model TaxUser {
  id        String   @id @default(uuid())
  pan       String   @unique
  dob       String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

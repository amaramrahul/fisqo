{
  "name": "fisqo-dev-container",
  "build": { "dockerfile": "Dockerfile" },
  "runArgs": ["--env-file", ".devcontainer/devcontainer.env"],
  "remoteUser": "node",
  "features": {
    "ghcr.io/devcontainers/features/common-utils": {},
    "ghcr.io/devcontainers/features/github-cli": {},
    "ghcr.io/anthropics/devcontainer-features/claude-code": {}
  },
  "mounts": [
    "source=${localEnv:HOME}${localEnv:USERPROFILE}/.claude,target=${localEnv:HOME}${localEnv:USERPROFILE}/.claude,type=bind,consistency=cached",
    "source=${localEnv:XDG_RUNTIME_DIR}/bus,target=/run/user/1000/bus,type=bind"
  ],
  "containerEnv": {
    "CLAUDE_CONFIG_DIR": "${localEnv:HOME}${localEnv:USERPROFILE}/.claude",
    "DBUS_SESSION_BUS_ADDRESS": "unix:path=/run/user/1000/bus"
  },
  "postCreateCommand": "sudo apt update && sudo env DEBIAN_FRONTEND=noninteractive apt install -y vim tmux libnotify-bin"
}
{
  "name": "fisqo",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "workspaces": ["packages/*"],
  "engines": { "node": ">=24" },
  "scripts": {
    "build:core": "npm run build --workspace @fisqo/core",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run build && npm run typecheck --workspace @fisqo/web",
    "pretest": "npm run build:core",
    "test": "vitest run",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
